{
  "name": "hollihop-tg-bot",
  "version": "1.0.0",
  "description": "Telegram-бот массовых рассылок для родителей и учеников с интеграцией HolliHop",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "sync": "node src/scripts/sync-cli.js",
    "sync:full": "node src/scripts/sync-cli.js full"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "telegraf": "^4.16.3"
  }
}
